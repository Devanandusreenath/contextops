# Frontend environment (copy to .env). VITE_* variables are PUBLIC - they are embedded in the browser bundle.
# NEVER put API keys or database passwords here; those belong only in the backend .env.
VITE_API_BASE_URL=http://localhost:8000
# Explicit, opt-in offline mode: shows the bundled fictional demo data WITHOUT calling the backend.
# Investigations cannot run offline. Default: false (a missing backend shows an error instead of mock data).
VITE_ENABLE_OFFLINE_FALLBACK=false
